{
  "name": "dadei-frontend",
  "version": "5.1.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"WEB,APP\" -c \"cyan,magenta\" \"npm run dev:website\" \"npm run dev:desktop\"",
    "dev:website": "npm run dev --workspace=apps/website",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build:website": "npm run build --workspace=apps/website",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "build:ui": "npm run build --workspace=@dadei/ui",
    "package:desktop": "npm run package --workspace=apps/desktop",
    "test": "npm run test --workspace=@dadei/ui",
    "check:versions": "node scripts/check-versions.mjs",
    "check:version-bump": "node scripts/check-version-bump.mjs",
    "version:patch": "npm version patch --workspaces --include-workspace-root --no-git-tag-version",
    "version:minor": "npm version minor --workspaces --include-workspace-root --no-git-tag-version",
    "version:major": "npm version major --workspaces --include-workspace-root --no-git-tag-version"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "trim-newlines": "^3.0.1",
    "meow": {
      "trim-newlines": "^3.0.1"
    },
    "meow@3.7.0": {
      "trim-newlines": "^3.0.1"
    }
  }
}
