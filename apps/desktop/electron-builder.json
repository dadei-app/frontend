{
  "electronVersion": "39.8.8",
  "appId": "com.dadei.app",
  "productName": "dadei",
  "copyright": "Copyright © 2026 Ankur Desai",
  "artifactName": "dadei-${version}-${os}-${arch}.${ext}",
  "afterSign": "scripts/notarize.cjs",
  "files": [
    "dist/**/*",
    "renderer/dist/**/*",
    "package.json",
    ".env.production"
  ],
  "directories": {
    "buildResources": "resources",
    "output": "release"
  },
  "asar": true,
  "asarUnpack": [
    "**/node_modules/easy-volume/**/volume.exe"
  ],
  "publish": {
    "provider": "github",
    "owner": "dadei-app",
    "repo": "frontend"
  },
  "win": {
    "target": "nsis",
    "icon": "resources/icon.png"
  },
  "nsis": {
    "differentialPackage": false
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "resources/icon.png",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "resources/entitlements.mac.plist",
    "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
    "extendInfo": {
      "NSLocationWhenInUseUsageDescription": "Dadei uses your location for timezone and local assistant context.",
      "NSMicrophoneUsageDescription": "Dadei uses the microphone for voice commands and wake word.",
      "NSScreenCaptureUsageDescription": "Dadei captures the screen when you ask for screenshots or window context."
    }
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "resources/icon.png",
    "category": "Utility"
  }
}
